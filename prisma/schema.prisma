generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  RECRUITER
  ADMIN
}

enum LabType {
  CTF
  BLUE_TEAM
  RED_TEAM
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  INSANE
}

enum AttemptStatus {
  IN_PROGRESS
  SOLVED
  ABANDONED
}

model User {
  id                   String    @id @default(cuid())
  clerkId              String?   @unique
  // Opaque foreign-system user id (e.g. a future Nexus-provisioned account).
  // Not used yet — reserved so account linking doesn't require a schema change later.
  externalId           String?   @unique
  email                String    @unique
  password             String?
  displayName          String?
  role                 Role      @default(STUDENT)
  // QA/internal accounts: excluded from every leaderboard, scoreboard, and the
  // public activity feed. Profile, certificates, and other self/direct-view
  // pages are unaffected — this only hides the account from discovery surfaces.
  hidden               Boolean   @default(false)
  university           String?
  linkedIn             String?
  github               String?
  skillScore           Int       @default(0)
  xp                   Int       @default(0)
  // SOC League currency — separate from skillScore/xp. Earned on lab solves
  // (see coinsForPoints in src/lib/soc-league.ts) and Daily Hunt bonuses.
  // Rank tier (Recruit -> CyberSage Champion) is derived from this, not skillScore.
  coins                Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  // Extended profile fields
  bio                  String?
  avatarUrl            String?
  skills               String[]
  cvUrl                String?
  company              String?
  jobTitle             String?
  website              String?
  profileExtra         Json?
  // Stripe billing
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String? // active | trialing | canceled | past_due
  subscriptionPlan     String? // classroom | enterprise
  trialEndsAt          DateTime?

  attempts                  Attempt[]
  writeups                  Writeup[]
  labResponses              LabResponse[]
  aiEvaluations             AIEvaluation[]
  simSessions               SimulationSession[]
  instructorClassrooms      Classroom[]                 @relation("InstructorClassrooms")
  enrollments               ClassroomEnrollment[]
  pathProgress              UserPathProgress[]
  usedHints                 UsedHint[]
  jobPostings               JobPosting[]                @relation("RecruiterPostings")
  recruiterBookmarks        CandidateBookmark[]         @relation("RecruiterBookmarks")
  candidateBookmarks        CandidateBookmark[]         @relation("CandidateBookmarks")
  ledTeams                  TeamSession[]               @relation("TeamLead")
  teamMemberships           TeamMember[]
  teamNotes                 TeamNote[]
  teamEvidence              TeamEvidence[]
  teamTasks                 TeamTask[]
  labChangelogs             LabChangelog[]
  auditLogs                 AuditLog[]
  customScenarios           CustomScenario[]            @relation("CreatedCustomScenarios")
  notifications             Notification[]
  certification             IRCertification?
  competitionEntries        CompetitionEntry[]
  championshipEntries       ChampionshipEntry[]
  championshipAwards        ChampionshipAward[]
  organizationMemberships   OrganizationMember[]
  feedReactions             FeedReaction[]
  feedComments              FeedComment[]
  quizAttempts              QuizAttempt[]
  assessmentSubmissions     AssessmentSubmission[]
  mentorReviews             MentorReview[]              @relation("MentorReviews")
  portfolioItems            PortfolioItem[]
  moduleProgress            UserModuleProgress[]
  cohortMemberships         CohortMember[]
  academyEnrollments        AcademyEnrollment[]
  academyLessonProgress     AcademyLessonProgress[]
  academyNotes              AcademyUserNote[]
  academyQuizAttempts       AcademyQuizAttempt[]
  academyCertificates       AcademyCertificate[]
  academyCardReviews        AcademyCardReview[]
  dailyHuntAttempts         DailyHuntAttempt[]
  incidentSimProgress       IncidentSimProgress[]
  socShiftAttempts          SocShiftAttempt[]
  incidentSimEvidenceBoards IncidentSimEvidenceBoard[]
  incidentSimReports        IncidentSimReport[]
  detectionSubmissions      DetectionSubmission[]
  purpleTeamReplaySessions  PurpleTeamReplaySession[]
  incidentHintViews         IncidentHintView[]
  announcementsCreated      Announcement[]
  certificateApprovals      CertificateApproval[]
  certApprovalDecisions     CertificateApproval[]       @relation("CertApprovalDecisions")
  careerPortfolio           CareerPortfolio?
  portfolioVisits           PortfolioVisitorLog[]       @relation("PortfolioVisitors")
  sharedRules               DetectionRuleShareAcl[]
  mentorHintSequences       MentorHintSequence[]
  huntInvestigationSessions HuntInvestigationSession[]
  weeklyIncidentLeaderboard WeeklyIncidentLeaderboard[]
  ticketQueueLeaderboard    TicketQueueLeaderboard[]

  // ── Phase 3: competition & community ──
  seasonRatings        SeasonRating[]
  ownedSquads          Squad[]             @relation("SquadOwner")
  squadMemberships     SquadMember[]
  squadInvitesReceived SquadInvite[]       @relation("SquadInviteRecipient")
  squadInvitesSent     SquadInvite[]       @relation("SquadInviteSender")
  tournamentEntries    TournamentEntrant[]
  following            Follow[]            @relation("FollowFollower")
  followers            Follow[]            @relation("FollowTarget")
  writeupVotes         WriteupVote[]
  peerReviews          PeerReview[]
  mentorshipsAsMentor  MentorshipPair[]    @relation("MentorshipMentor")
  mentorshipsAsMentee  MentorshipPair[]    @relation("MentorshipMentee")

  // ── Phase 4: professional development ──
  jobApplications         JobApplication[]
  jobApplicationEvents    JobApplicationEvent[]
  skillGapSnapshots       SkillGapSnapshot[]
  interviewSessions       InterviewSession[]
  skillAssessmentAttempts SkillAssessmentAttempt[]
  verifiedCredentials     VerifiedCredential[]
  CrisisRun               CrisisRun[]
  ScenarioRating          ScenarioRating[]
  scenarioReportsFiled    ScenarioReport[]         @relation("ScenarioReportsFiled")
  scenarioReportsReviewed ScenarioReport[]         @relation("ScenarioReportsReviewed")

  @@index([skillScore])
  @@index([coins])
}

// ── Certificate Approval Workflow ─────────────────────────────────────────────
// Completing a certificate's requirements no longer reveals it directly:
// a PENDING approval request is created (admins are notified), and the
// user only sees/claims the certificate once an admin approves.

enum CertApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CertKind {
  PATH
  ACADEMY
  IR
  LABS
  SIMULATION
}

model CertificateApproval {
  id          String             @id @default(cuid())
  userId      String
  kind        CertKind
  // pathId for PATH, courseId for ACADEMY, "" for the single IR certification —
  // kept non-null so the compound unique key below works for all kinds.
  targetId    String             @default("")
  // Human-readable label captured at request time (path/course title) so the
  // admin queue doesn't need per-kind joins to render.
  title       String
  status      CertApprovalStatus @default(PENDING)
  requestedAt DateTime           @default(now())
  decidedAt   DateTime?
  decidedById String?

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("CertApprovalDecisions", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([userId, kind, targetId])
  @@index([status, requestedAt])
}

model Lab {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String
  type        LabType
  difficulty  Difficulty
  category    String
  points      Int        @default(100)
  version     Int        @default(1)
  published   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  flags                Flag[]
  attempts             Attempt[]
  labResponses         LabResponse[]
  classroomAssignments ClassroomLabAssignment[]
  pathLabs             PathLab[]
  hints                LabHint[]
  writeups             Writeup[]
  changelog            LabChangelog[]
  dailyHunts           DailyHunt[]
  mentorHintSequences  MentorHintSequence[]

  @@index([type, difficulty])
}

model LabChangelog {
  id          String   @id @default(cuid())
  labId       String
  version     Int
  summary     String
  changedById String
  createdAt   DateTime @default(now())

  lab       Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([labId, version])
}

model Flag {
  id            String  @id @default(cuid())
  labId         String
  value         String
  points        Int     @default(100)
  // Flags are formatted SAGE{lowercase_leetspeak} — case differences are
  // never meaningful to whether a submission is correct, and every seed
  // script has relied on this default without ever setting it explicitly.
  // Defaulting to case-sensitive here silently rejected objectively correct
  // answers (e.g. "sage{...}" vs "SAGE{...}") across every non-task-based
  // lab. Matches the case-insensitive behavior already used by the
  // per-task checkFlag() validators in labs/[slug]/_components/*.
  caseSensitive Boolean @default(false)

  lab Lab @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([labId])
}

model Attempt {
  id            String        @id @default(cuid())
  userId        String
  labId         String
  status        AttemptStatus @default(IN_PROGRESS)
  score         Int           @default(0)
  // Wrong submissions before the lab was solved. Drives the award penalty in
  // src/lib/scoring.ts, so a brute-forced solve ranks below a clean one.
  wrongAttempts Int           @default(0)
  labVersion    Int           @default(1)
  startedAt     DateTime      @default(now())
  solvedAt      DateTime?
  timeTakenSec  Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([userId, labId])
  @@index([userId])
  @@index([labId])
}

model LabResponse {
  id        String   @id @default(cuid())
  userId    String
  labId     String
  stage     String
  response  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab          Lab           @relation(fields: [labId], references: [id], onDelete: Cascade)
  aiEvaluation AIEvaluation?

  @@unique([userId, labId, stage])
  @@index([userId])
  @@index([labId])
}

model AIEvaluation {
  id                String   @id @default(cuid())
  userId            String
  labId             String?
  labResponseId     String?  @unique
  accuracyScore     Int
  clarityScore      Int
  completenessScore Int
  recommendation    String
  feedback          String   @db.Text
  createdAt         DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  labResponse LabResponse? @relation(fields: [labResponseId], references: [id])

  @@index([userId])
}

// ── Simulation Engine ─────────────────────────────────────────────────────────

enum SimulationStatus {
  ACTIVE
  CONTAINED
  BREACHED
  ABANDONED
}

model CustomScenario {
  id                 String     @id @default(cuid())
  title              String
  subtitle           String
  briefing           String     @db.Text
  difficulty         Difficulty
  estimatedMinutes   Int        @default(45)
  personaId          String
  archetypeId        String
  templateSlug       String
  learningObjectives String[]
  tags               String[]
  realWorldAnalogue  String?
  published          Boolean    @default(false)
  createdById        String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Community sharing. PRIVATE is the safe default for anything newly
  // authored; COMMUNITY is the only value that appears in the gallery.
  visibility   ScenarioVisibility @default(PRIVATE)
  // Set when this scenario was cloned from another. SetNull rather than
  // Cascade: deleting an original must not delete everyone's forks.
  clonedFromId String?

  createdBy      User      @relation("CreatedCustomScenarios", fields: [createdById], references: [id], onDelete: Cascade)
  // Moderation. Set when a scenario is removed from circulation; the author
  // keeps read access but cannot restore it to the gallery themselves.
  takenDownAt    DateTime?
  takedownReason String?   @db.Text

  clonedFrom CustomScenario?  @relation("ScenarioClones", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones     CustomScenario[] @relation("ScenarioClones")
  ratings    ScenarioRating[]
  reports    ScenarioReport[]

  @@index([createdById])
  @@index([published])
  @@index([visibility, createdAt])
  @@index([clonedFromId])
}

model ScenarioRating {
  id         String   @id @default(cuid())
  scenarioId String
  userId     String
  // Whole stars, 1-5.
  stars      Int
  review     String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  scenario CustomScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One rating per person per scenario; re-rating updates rather than stacks.
  @@unique([scenarioId, userId])
  @@index([scenarioId])
}

enum ScenarioVisibility {
  // Only the author (and admins, for moderation).
  PRIVATE
  // Anyone with the link, but never listed in the gallery.
  UNLISTED
  // Listed publicly in the community gallery.
  COMMUNITY
}

model ScenarioTemplate {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String
  industry    String
  difficulty  Difficulty
  published   Boolean    @default(true)
  createdAt   DateTime   @default(now())

  sessions SimulationSession[]
}

model SimulationSession {
  id              String           @id @default(cuid())
  userId          String
  templateId      String
  companyData     Json
  status          SimulationStatus @default(ACTIVE)
  currentStage    String           @default("NORMAL")
  score           Int              @default(0)
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  adversaryState  Json?
  adversaryMemory Json?
  scenarioId      String?
  personaId       String?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template    ScenarioTemplate  @relation(fields: [templateId], references: [id])
  events      SimulationEvent[]
  teamSession TeamSession?

  @@index([userId])
  @@index([status])
}

model SimulationEvent {
  id        String   @id @default(cuid())
  sessionId String
  type      String
  actor     String
  payload   Json
  narrative String?  @db.Text
  createdAt DateTime @default(now())

  session SimulationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

// ── Classroom ─────────────────────────────────────────────────────────────────

model Classroom {
  id           String   @id @default(cuid())
  name         String
  joinCode     String   @unique
  instructorId String
  webhookUrl   String?
  createdAt    DateTime @default(now())

  instructor     User                     @relation("InstructorClassrooms", fields: [instructorId], references: [id], onDelete: Cascade)
  enrollments    ClassroomEnrollment[]
  assignments    ClassroomLabAssignment[]
  announcements  ClassroomAnnouncement[]
  simAssignments ClassroomSimAssignment[]

  @@index([instructorId])
}

model ClassroomAnnouncement {
  id          String   @id @default(cuid())
  classroomId String
  content     String
  createdAt   DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId])
}

model ClassroomSimAssignment {
  id          String    @id @default(cuid())
  classroomId String
  scenarioId  String
  title       String
  assignedAt  DateTime  @default(now())
  dueDate     DateTime?

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([classroomId, scenarioId])
  @@index([classroomId])
}

model ClassroomEnrollment {
  id          String   @id @default(cuid())
  classroomId String
  userId      String
  enrolledAt  DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@index([userId])
}

model ClassroomLabAssignment {
  id          String    @id @default(cuid())
  classroomId String
  labId       String
  assignedAt  DateTime  @default(now())
  dueDate     DateTime?

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  lab       Lab       @relation(fields: [labId], references: [id])

  @@unique([classroomId, labId])
}

// ── Learning Paths ────────────────────────────────────────────────────────────

model LearningPath {
  id                     String   @id @default(cuid())
  slug                   String   @unique
  title                  String
  description            String
  order                  Int      @default(0)
  published              Boolean  @default(false)
  // Soft reference (by slug) to an IncidentSimulation that unlocks once every
  // PathLab step below is completed. Not a hard FK — capstones live in a
  // separate content model (Incident Simulations) from PathLab's Lab steps.
  capstoneSimulationSlug String?
  createdAt              DateTime @default(now())

  labs        PathLab[]
  modules     Module[]
  progress    UserPathProgress[]
  cohortPaths CohortPath[]
}

model PathLab {
  id     String @id @default(cuid())
  pathId String
  labId  String
  order  Int

  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  lab  Lab          @relation(fields: [labId], references: [id])

  @@unique([pathId, labId])
  @@unique([pathId, order])
}

model UserPathProgress {
  id          String    @id @default(cuid())
  userId      String
  pathId      String
  completedAt DateTime?
  startedAt   DateTime  @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  path LearningPath @relation(fields: [pathId], references: [id])

  @@unique([userId, pathId])
  @@index([userId])
}

// ── Hint System ───────────────────────────────────────────────────────────────

model LabHint {
  id        String @id @default(cuid())
  labId     String
  stage     String
  level     Int
  text      String @db.Text
  pointCost Int    @default(10)

  lab  Lab        @relation(fields: [labId], references: [id], onDelete: Cascade)
  used UsedHint[]

  @@unique([labId, stage, level])
  @@index([labId, stage])
}

model UsedHint {
  id                String   @id @default(cuid())
  userId            String
  hintId            String
  usedAt            DateTime @default(now())
  // Phase 2: AI Mentor tracking
  qualityScore      Int? // 0-10: how much it helped (user feedback)
  wasHelpful        Boolean? // Thumbs up/down
  contextDifficulty String? // EASY, MEDIUM, HARD, INSANE when hint viewed
  submissionLater   Boolean  @default(false) // Did they solve after viewing?
  timeThenSolvedSec Int? // Time from hint to solution

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  hint LabHint @relation(fields: [hintId], references: [id])

  @@unique([userId, hintId])
  @@index([userId])
  @@index([userId, usedAt]) // For adaptive sequencing
  @@index([qualityScore]) // For effectiveness analysis
}

// ── Recruiter Marketplace ─────────────────────────────────────────────────────

model JobPosting {
  id           String   @id @default(cuid())
  recruiterId  String
  title        String
  company      String
  description  String   @db.Text
  requirements Json
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // ── Phase 4 job board fields ──
  slug           String?        @unique
  location       String?
  remote         Boolean        @default(false)
  employmentType EmploymentType @default(FULL_TIME)
  seniority      SeniorityLevel @default(JUNIOR)
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?        @default("GBP")
  closesAt       DateTime?

  recruiter User                @relation("RecruiterPostings", fields: [recruiterId], references: [id], onDelete: Cascade)
  bookmarks CandidateBookmark[]

  applications JobApplication[]

  @@index([recruiterId])
  @@index([active])
  @@index([active, seniority])
}

model CandidateBookmark {
  id          String   @id @default(cuid())
  recruiterId String
  candidateId String
  jobId       String?
  note        String?
  createdAt   DateTime @default(now())

  recruiter User        @relation("RecruiterBookmarks", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate User        @relation("CandidateBookmarks", fields: [candidateId], references: [id], onDelete: Cascade)
  job       JobPosting? @relation(fields: [jobId], references: [id])

  @@unique([recruiterId, candidateId])
  @@index([recruiterId])
}

// ── Team Simulations ──────────────────────────────────────────────────────────

enum TeamStatus {
  LOBBY
  ACTIVE
  COMPLETE
}

enum TeamRole {
  IR_LEAD
  FORENSICS
  LEGAL
  COMMS
}

model TeamSession {
  id           String     @id @default(cuid())
  code         String     @unique
  leadId       String
  sessionId    String?    @unique
  templateSlug String
  status       TeamStatus @default(LOBBY)
  createdAt    DateTime   @default(now())

  lead     User               @relation("TeamLead", fields: [leadId], references: [id], onDelete: Cascade)
  session  SimulationSession? @relation(fields: [sessionId], references: [id])
  members  TeamMember[]
  notes    TeamNote[]
  evidence TeamEvidence[]
  tasks    TeamTask[]

  @@index([leadId])
  @@index([status])
}

model TeamMember {
  id            String    @id @default(cuid())
  teamSessionId String
  userId        String
  role          TeamRole?
  joinedAt      DateTime  @default(now())

  teamSession TeamSession @relation(fields: [teamSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamSessionId, userId])
  @@index([teamSessionId])
}

model TeamNote {
  id            String   @id @default(cuid())
  teamSessionId String
  authorId      String
  content       String
  createdAt     DateTime @default(now())

  teamSession TeamSession @relation(fields: [teamSessionId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([teamSessionId, createdAt])
}

model TeamEvidence {
  id            String   @id @default(cuid())
  teamSessionId String
  pinnedById    String
  title         String
  content       String
  tag           String   @default("INDICATOR")
  createdAt     DateTime @default(now())

  teamSession TeamSession @relation(fields: [teamSessionId], references: [id], onDelete: Cascade)
  pinnedBy    User        @relation(fields: [pinnedById], references: [id], onDelete: Cascade)

  @@index([teamSessionId])
}

model TeamTask {
  id            String    @id @default(cuid())
  teamSessionId String
  createdById   String
  assignedRole  TeamRole?
  title         String
  done          Boolean   @default(false)
  createdAt     DateTime  @default(now())

  teamSession TeamSession @relation(fields: [teamSessionId], references: [id], onDelete: Cascade)
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([teamSessionId])
}

// ── Credentialing ─────────────────────────────────────────────────────────────

model IRCertification {
  id         String   @id @default(cuid())
  userId     String   @unique
  certId     String   @unique
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([certId])
}

// ── Organization Licensing ──────────────────────────────────────────────────
// NOTE: Organization/OrganizationMember are mapped onto the pre-existing
// Institution/InstitutionMember tables via @@map/@map — this is a pure
// rename at the Prisma Client level, no underlying table/column changes,
// so it's safe to `db push` without any data migration.

enum InstitutionPlan {
  TRIAL
  BASIC
  PRO
  ENTERPRISE
}

model Organization {
  id               String          @id @default(cuid())
  name             String
  contactEmail     String
  plan             InstitutionPlan @default(TRIAL)
  seats            Int             @default(30)
  active           Boolean         @default(true)
  expiresAt        DateTime?
  joinCode         String          @unique
  // Email domain (e.g. "cybersage.uk") — new signups with a matching email
  // domain are auto-joined to this org. Optional: orgs can also be joined
  // purely via joinCode.
  domain           String?         @unique
  stripeCustomerId String?
  notes            String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  members      OrganizationMember[]
  cohorts      Cohort[]
  competitions Competition[]

  @@map("Institution")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String   @map("institutionId")
  userId         String
  // Org Lead: can view aggregate team progress + export data for the org.
  // Stacks on top of the member's normal STUDENT/INSTRUCTOR/RECRUITER access —
  // it does not replace it.
  isLead         Boolean  @default(false) @map("isAdmin")
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("InstitutionMember")
}

// ── Competitions ──────────────────────────────────────────────────────────────

model Competition {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  startDate   DateTime
  endDate     DateTime
  freezeAt    DateTime?
  prizeDesc   String?
  published   Boolean   @default(false)
  labSlugs    Json
  createdAt   DateTime  @default(now())

  // Who may see and enter. PUBLIC is the historical behaviour and stays the
  // default so existing rows keep working after this migration.
  visibility     CompetitionVisibility @default(PUBLIC)
  // Set for ORGANIZATION events. SetNull rather than Cascade: losing an org
  // should not silently delete its competition history.
  organizationId String?
  // Set for COHORT events, narrowing an org event to one classroom.
  cohortId       String?
  // Required for INVITE_ONLY. Unique so a code identifies one competition.
  inviteCode     String?               @unique

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  cohort       Cohort?       @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  entries CompetitionEntry[]

  @@index([published, visibility])
  @@index([organizationId])
  @@index([cohortId])
}

enum CompetitionVisibility {
  // Anyone signed in.
  PUBLIC
  // Members of the owning organization only.
  ORGANIZATION
  // Members of the owning cohort only.
  COHORT
  // Anyone holding the invite code.
  INVITE_ONLY
}

model CompetitionEntry {
  id            String    @id @default(cuid())
  competitionId String
  userId        String
  score         Int       @default(0)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
  @@index([competitionId])
  @@index([userId])
}

// ── SOC League: Daily Hunt ──────────────────────────────────────────────────
// Foundation piece for the gamification/competition layer. Distinct from
// Competition/CompetitionEntry (org-run, date-ranged, opt-in leaderboards) —
// Daily Hunt is one automatically-rotating mystery lab per calendar day,
// available to everyone, that pays out a bonus-coin reward on top of the
// lab's normal skillScore/xp if solved within the time limit.

model DailyHunt {
  id           String   @id @default(cuid())
  // Stored as UTC midnight for the calendar day this hunt is live.
  date         DateTime @unique
  labId        String
  bonusCoins   Int      @default(50)
  timeLimitSec Int      @default(1800)
  createdAt    DateTime @default(now())

  lab      Lab                @relation(fields: [labId], references: [id], onDelete: Cascade)
  attempts DailyHuntAttempt[]

  @@index([date])
}

model DailyHuntAttempt {
  id           String    @id @default(cuid())
  dailyHuntId  String
  userId       String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  timeTakenSec Int?
  coinsAwarded Int       @default(0)

  dailyHunt DailyHunt @relation(fields: [dailyHuntId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dailyHuntId, userId])
  @@index([userId])
}

// ── Feed Reactions ────────────────────────────────────────────────────────────

model FeedReaction {
  id        String   @id @default(cuid())
  userId    String
  entryId   String
  entryType String
  reaction  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId, entryType, reaction])
  @@index([entryId, entryType])
  @@index([userId])
}

model FeedComment {
  id        String   @id @default(cuid())
  userId    String
  entryId   String
  entryType String
  body      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entryId, entryType])
  @@index([userId])
}

// ── Rate Limiting ─────────────────────────────────────────────────────────────

model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ── Plan Pricing ──────────────────────────────────────────────────────────────

model PlanPricing {
  id        String   @id @default(cuid())
  role      String   @unique // STUDENT | INSTRUCTOR | RECRUITER
  label     String
  priceAmt  Int      @default(0) // cents per month; 0 = free
  updatedAt DateTime @updatedAt

  @@index([role])
}

// ── Vouchers ──────────────────────────────────────────────────────────────────

model Voucher {
  id          String    @id @default(cuid())
  code        String    @unique
  discountPct Int       @default(0) // 0-100 percentage off
  discountAmt Int       @default(0) // fixed discount in cents (applied after pct)
  maxUses     Int? // null = unlimited
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([code])
}

// ── Stripe Webhook Idempotency ────────────────────────────────────────────────

model StripeWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  processedAt   DateTime @default(now())
}

// ── Product Analytics ─────────────────────────────────────────────────────────

model AnalyticsEvent {
  id         String   @id @default(cuid())
  event      String
  userId     String?
  properties Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
}

// ── Modules & Structured Learning ────────────────────────────────────────────

enum ResourceType {
  PDF
  ARTICLE
  DOCUMENTATION
  GITHUB
  EXTERNAL_LINK
  TOOL_DOWNLOAD
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MULTIPLE_SELECT
  SHORT_ANSWER
}

enum SubmissionType {
  TEXT
  PDF
  IMAGE
  ZIP
  GITHUB_LINK
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model Module {
  id              String   @id @default(cuid())
  pathId          String
  title           String
  overview        String   @db.Text
  readingMaterial String   @db.Text
  order           Int
  isRequired      Boolean  @default(true)
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  path       LearningPath         @relation(fields: [pathId], references: [id], onDelete: Cascade)
  resources  ModuleResource[]
  quiz       Quiz?
  assessment Assessment?
  progress   UserModuleProgress[]

  @@unique([pathId, order])
  @@index([pathId])
}

model ModuleResource {
  id       String       @id @default(cuid())
  moduleId String
  title    String
  type     ResourceType
  url      String
  order    Int          @default(0)

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model Quiz {
  id          String   @id @default(cuid())
  moduleId    String   @unique
  title       String
  description String?
  passMark    Int      @default(70)
  createdAt   DateTime @default(now())

  module    Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String
  type          QuestionType
  question      String       @db.Text
  options       Json?
  correctAnswer Json
  explanation   String?      @db.Text
  order         Int

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  score       Int
  passed      Boolean
  completedAt DateTime @default(now())

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizId, userId])
  @@index([userId])
}

model QuizAnswer {
  id         String @id @default(cuid())
  attemptId  String
  questionId String
  answer     Json

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model Assessment {
  id           String   @id @default(cuid())
  moduleId     String   @unique
  title        String
  instructions String   @db.Text
  createdAt    DateTime @default(now())

  module      Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions AssessmentSubmission[]
  rubric      AssessmentRubric?
}

model AssessmentSubmission {
  id           String         @id @default(cuid())
  assessmentId String
  userId       String
  type         SubmissionType
  content      String         @db.Text
  submittedAt  DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  assessment Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  review     MentorReview?
  portfolio  PortfolioItem?

  @@unique([assessmentId, userId])
  @@index([assessmentId])
  @@index([userId])
}

model MentorReview {
  id           String       @id @default(cuid())
  submissionId String       @unique
  reviewerId   String
  status       ReviewStatus
  grade        String?
  comment      String?      @db.Text
  reviewedAt   DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  submission   AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer     User                 @relation("MentorReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  rubricScores RubricScore[]
}

model PortfolioItem {
  id           String   @id @default(cuid())
  userId       String
  submissionId String   @unique
  title        String
  description  String   @db.Text
  grade        String?
  feedback     String?  @db.Text
  isPublic     Boolean  @default(true)
  completedAt  DateTime @default(now())

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserModuleProgress {
  id             String    @id @default(cuid())
  userId         String
  moduleId       String
  quizPassed     Boolean   @default(false)
  assessmentDone Boolean   @default(false)
  completedAt    DateTime?
  startedAt      DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
}

// ── Cohorts ───────────────────────────────────────────────────────────────────

model Cohort {
  id             String    @id @default(cuid())
  name           String
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  joinCode       String    @unique
  published      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  // Optional: set when a cohort belongs to an Organization (e.g. auto-provisioned
  // via Nexus SSO). Null for standalone instructor-created cohorts.
  organizationId String?

  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  members      CohortMember[]
  paths        CohortPath[]
  competitions Competition[]

  @@index([organizationId])
}

model CohortMember {
  id       String   @id @default(cuid())
  cohortId String
  userId   String
  joinedAt DateTime @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
  @@index([cohortId])
  @@index([userId])
}

model CohortPath {
  id       String @id @default(cuid())
  cohortId String
  pathId   String

  cohort Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  path   LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([cohortId, pathId])
  @@index([cohortId])
}

// ── Assessment Rubrics ────────────────────────────────────────────────────────

model AssessmentRubric {
  id           String   @id @default(cuid())
  assessmentId String   @unique
  createdAt    DateTime @default(now())

  assessment Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criteria   RubricCriterion[]
}

model RubricCriterion {
  id       String @id @default(cuid())
  rubricId String
  label    String
  maxScore Int    @default(10)
  order    Int    @default(0)

  rubric AssessmentRubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  scores RubricScore[]

  @@index([rubricId])
}

model RubricScore {
  id          String @id @default(cuid())
  criterionId String
  reviewId    String
  score       Int

  criterion RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  review    MentorReview    @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([criterionId, reviewId])
  @@index([reviewId])
}

// ── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // lab_assigned | sim_complete | badge_earned | writeup_approved | scenario_published | announcement
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// Company-wide/platform broadcasts shown on the student dashboard — distinct
// from Notification (per-user, has read state). Admin-authored, everyone
// sees the same feed, no read tracking needed.
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  href        String?
  published   Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([published, createdAt])
}

// ── Writeups ──────────────────────────────────────────────────────────────────

enum WriteupStatus {
  PENDING
  APPROVED
  REJECTED
}

model Writeup {
  id        String        @id @default(cuid())
  userId    String
  labId     String
  title     String
  body      String        @db.Text
  status    WriteupStatus @default(PENDING)
  verdict   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)

  votes   WriteupVote[]
  reviews PeerReview[]

  @@unique([userId, labId])
  @@index([labId, status])
  @@index([userId])
}

// ── Audit Log ─────────────────────────────────────────────────────────────────
// Immutable append-only log of security-relevant events.
// Rows are never updated or deleted — query for review and export only.

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  ROLE_CHANGE
  FILE_UPLOAD
  ADMIN_USER_DELETE
  ADMIN_USER_ROLE_CHANGE
  ASSESSMENT_ACCESS
  FLAG_SUBMIT
  LAB_VERSION_BUMP
  SSO_PROVISION
  PASSWORD_CHANGED
  INCIDENT_TASK_SUBMIT
  INCIDENT_REPORT_SUBMIT
  DETECTION_CHALLENGE_SUBMIT
  PURPLE_TEAM_REPLAY_COMPLETE
  SOC_SHIFT_COMPLETE
  INCIDENT_WEEKLY_CREATE
  SEASON_CREATE
  SEASON_CONCLUDE
  SQUAD_CREATE
  SQUAD_DISBAND
  SQUAD_MEMBER_REMOVE
  TOURNAMENT_CREATE
  TOURNAMENT_START
  TOURNAMENT_MATCH_REPORT
  ADMIN_SCENARIO_MODERATE
}

model AuditLog {
  id        String      @id @default(cuid())
  actorId   String? // null for unauthenticated events (failed logins)
  action    AuditAction
  target    String? // what was acted upon (userId, labSlug, fileUrl, etc.)
  meta      Json? // additional context (IP, user-agent, old/new values)
  ip        String?
  createdAt DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

// ── Academy ───────────────────────────────────────────────────────────────────

enum AcademyCategory {
  FUNDAMENTALS
  BLUE_TEAM
  RED_TEAM
  FORENSICS
  SECURITY_ENGINEERING
  NETWORKING
  CLOUD
}

enum AcademyBlockType {
  TEXT
  CODE
  IMAGE
  CALLOUT
  KNOWLEDGE_CHECK
  // Paced formats that do what a lecture video does, without the video: a
  // terminal session that replays keystroke by keystroke, an investigation the
  // learner advances a step at a time, and an attack chain that draws itself.
  TERMINAL
  WALKTHROUGH
  DIAGRAM
  // Construct-an-answer practice. KNOWLEDGE_CHECK tests recall by picking an
  // option; this asks the learner to build the command themselves, which is
  // what the labs actually require of them.
  PRACTICE
}

enum AcademyQuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  FILL_BLANK
  TRUE_FALSE
  MATCH_PAIRS
}

model AcademyCourse {
  id            String          @id @default(cuid())
  slug          String          @unique
  title         String
  subtitle      String?
  description   String          @db.Text
  category      AcademyCategory
  difficulty    Difficulty
  estimatedHrs  Int             @default(0)
  thumbnail     String?
  published     Boolean         @default(false)
  order         Int             @default(0)
  prerequisites String[]
  objectives    String[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  modules      AcademyModule[]
  enrollments  AcademyEnrollment[]
  certificates AcademyCertificate[]
  cheatSheets  AcademyCheatSheet[]
}

model AcademyModule {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  AcademyCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons AcademyLesson[]
  quiz    AcademyQuiz?

  @@unique([courseId, order])
  @@index([courseId])
}

model AcademyLesson {
  id          String   @id @default(cuid())
  moduleId    String
  title       String
  summary     String?
  order       Int
  published   Boolean  @default(false)
  durationMin Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module     AcademyModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  blocks     AcademyLessonBlock[]
  flashcards AcademyFlashcard[]
  notes      AcademyUserNote[]
  progress   AcademyLessonProgress[]

  @@unique([moduleId, order])
  @@index([moduleId])
}

model AcademyLessonBlock {
  id       String           @id @default(cuid())
  lessonId String
  type     AcademyBlockType
  order    Int
  content  Json

  lesson AcademyLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model AcademyQuiz {
  id          String   @id @default(cuid())
  moduleId    String   @unique
  title       String
  description String?
  passMark    Int      @default(70)
  createdAt   DateTime @default(now())

  module    AcademyModule        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions AcademyQuestion[]
  attempts  AcademyQuizAttempt[]
}

model AcademyQuestion {
  id            String              @id @default(cuid())
  quizId        String
  type          AcademyQuestionType
  question      String              @db.Text
  options       Json?
  correctAnswer Json
  explanation   String?             @db.Text
  order         Int

  quiz    AcademyQuiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers AcademyQuizAnswer[]

  @@index([quizId])
}

model AcademyQuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  score       Int
  passed      Boolean
  completedAt DateTime @default(now())

  quiz    AcademyQuiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers AcademyQuizAnswer[]

  @@index([quizId, userId])
  @@index([userId])
}

model AcademyQuizAnswer {
  id         String @id @default(cuid())
  attemptId  String
  questionId String
  answer     Json

  attempt  AcademyQuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question AcademyQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model AcademyEnrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course AcademyCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model AcademyLessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime?
  startedAt   DateTime  @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson AcademyLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model AcademyUserNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson AcademyLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model AcademyFlashcard {
  id        String   @id @default(cuid())
  lessonId  String
  front     String
  back      String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  lesson  AcademyLesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  reviews AcademyCardReview[]

  @@index([lessonId])
}

/// Per-learner SM-2 scheduling state for one flashcard.
///
/// Kept off AcademyFlashcard deliberately: the card is authored content shared
/// by every learner, while interval and ease are personal. A card can be
/// rewritten without disturbing anyone's schedule, and a learner's history
/// survives content edits.
model AcademyCardReview {
  id          String @id @default(cuid())
  userId      String
  flashcardId String

  /// Consecutive successful reviews. Reset to zero by a lapse.
  repetitions Int      @default(0)
  /// Current spacing in days. Zero means the card is still in learning.
  intervalDays Int     @default(0)
  /// SM-2 ease factor, floored at 1.3.
  easeFactor  Float    @default(2.5)
  dueAt       DateTime @default(now())
  /// Times a previously-learned card was forgotten. High counts mark a leech.
  lapses      Int      @default(0)
  reviews     Int      @default(0)

  lastGrade      String?
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard AcademyFlashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@index([userId, dueAt])
  @@index([flashcardId])
}

model AcademyCertificate {
  id       String   @id @default(cuid())
  userId   String
  courseId String
  certCode String   @unique
  issuedAt DateTime @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course AcademyCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model AcademyCheatSheet {
  id          String   @id @default(cuid())
  courseId    String?
  title       String
  description String?
  content     String   @db.Text
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course AcademyCourse? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([courseId])
}

// ── Incident Simulations (curated, multi-artifact scenarios) ──────────────────
// Distinct from SimulationSession/CustomScenario above, which is the live
// AI-generated red-vs-blue engine. These are fixed, authored scenarios — a
// chained sequence of tasks read against a bundle of realistic artifacts
// (event logs, Sysmon, PCAP summaries, email, memory dumps, registry, etc.),
// scoped inside a fictional CompanyEnvironment. Think "one big multi-hour lab"
// rather than a dynamic simulation.

enum CompanyIndustry {
  FINANCE
  HEALTHCARE
  EDUCATION
  MANUFACTURING
  RETAIL
  GOVERNMENT
  TECHNOLOGY
}

model CompanyEnvironment {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  industry      CompanyIndustry
  description   String          @db.Text
  employeeCount Int
  networkNotes  String?         @db.Text
  published     Boolean         @default(true)
  createdAt     DateTime        @default(now())

  incidentSimulations IncidentSimulation[]

  @@index([industry])
}

enum SimArtifactType {
  EVENT_LOG
  SYSMON_LOG
  DEFENDER_LOG
  PCAP_SUMMARY
  EMAIL
  MEMORY_DUMP
  REGISTRY
  TIMELINE
  FILE_LISTING
}

enum SimTaskAnswerType {
  FREE_TEXT
  RADIO
}

model IncidentSimulation {
  id               String     @id @default(cuid())
  slug             String     @unique
  codename         String
  title            String
  companyId        String
  briefing         String     @db.Text
  difficulty       Difficulty
  estimatedMinutes Int        @default(150)
  points           Int        @default(1000)
  published        Boolean    @default(true)
  // When true, artifact/task content is a template containing {{TOKEN}}
  // placeholders — the Simulation Generator substitutes deterministic
  // per-(user, simulation) values at request time. See src/lib/incident-randomizer.ts.
  randomized       Boolean    @default(false)
  // Interactive Network Map data: node list and status-change events keyed
  // to task completion order. Both are plain JSON rather than relational
  // tables since they're small, simulation-authored, and never queried on
  // their own — see src/app/incidents/[slug]/_components/network-map.tsx.
  networkNodes     Json?
  networkEvents    Json?
  // Learning Paths reference simulations by slug (see LearningPathStep) —
  // no FK needed since a path step can equally reference a Lab slug.
  isCapstone       Boolean    @default(false)
  createdAt        DateTime   @default(now())

  company        CompanyEnvironment         @relation(fields: [companyId], references: [id])
  artifacts      IncidentSimArtifact[]
  tasks          IncidentSimTask[]
  progress       IncidentSimProgress[]
  evidenceBoards IncidentSimEvidenceBoard[]
  reports        IncidentSimReport[]

  @@index([companyId])
}

enum MitreTactic {
  INITIAL_ACCESS
  PERSISTENCE
  PRIVILEGE_ESCALATION
  LATERAL_MOVEMENT
  COMMAND_AND_CONTROL
  EXFILTRATION
  IMPACT
}

model IncidentSimArtifact {
  id           String          @id @default(cuid())
  simulationId String
  type         SimArtifactType
  title        String
  content      String          @db.Text
  order        Int
  // Null for meta/reference artifacts (e.g. the consolidated timeline, or a
  // pure detection log) that don't map to one Evidence Board tactic bucket.
  tactic       MitreTactic?

  simulation IncidentSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId])
}

model IncidentSimTask {
  id            String            @id @default(cuid())
  simulationId  String
  order         Int
  title         String
  prompt        String            @db.Text
  answerType    SimTaskAnswerType
  correctAnswer String            @db.Text
  options       String[]
  points        Int               @default(100)

  simulation IncidentSimulation    @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  hints      IncidentSimHint[]
  progress   IncidentSimProgress[]

  @@index([simulationId])
}

model IncidentSimHint {
  id        String @id @default(cuid())
  taskId    String
  level     Int
  pointCost Int
  text      String @db.Text

  task  IncidentSimTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  views IncidentHintView[]

  @@index([taskId])
}

// Analytics-only reveal tracking for Boss Fight hints. Unlike LabHint/UsedHint,
// incident sim hints are free to reveal (no point cost deducted, no gating) —
// this table exists purely so instructor analytics can answer "how much are
// students leaning on hints" for Boss Fights the same way it already can for
// Labs, without changing the existing free-hint game economy.
model IncidentHintView {
  id       String   @id @default(cuid())
  userId   String
  hintId   String
  viewedAt DateTime @default(now())

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  hint IncidentSimHint @relation(fields: [hintId], references: [id], onDelete: Cascade)

  @@unique([userId, hintId])
  @@index([userId])
  @@index([hintId])
}

model IncidentSimProgress {
  id           String   @id @default(cuid())
  userId       String
  simulationId String
  taskId       String
  completedAt  DateTime @default(now())

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulation IncidentSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  task       IncidentSimTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
  @@index([simulationId])
}

// ── Evidence Board ────────────────────────────────────────────────────────────
// A drag-and-drop investigation workspace: categorize artifacts into MITRE
// tactic buckets, then order them into a timeline, before writing the report.

model IncidentSimEvidenceBoard {
  id             String    @id @default(cuid())
  userId         String
  simulationId   String
  // Map of artifactId -> the MitreTactic the student assigned it to.
  categorization Json
  // Ordered list of artifact IDs representing the student's timeline.
  timelineOrder  String[]
  score          Int?
  accuracyPct    Int?
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulation IncidentSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([userId, simulationId])
  @@index([userId])
}

// ── Executive Report Builder ──────────────────────────────────────────────────

model IncidentSimReport {
  id                     String    @id @default(cuid())
  userId                 String
  simulationId           String
  executiveSummary       String    @db.Text
  incidentTimeline       String    @db.Text
  technicalFindings      String    @db.Text
  mitreMapping           String    @db.Text
  indicatorsOfCompromise String    @db.Text
  businessImpact         String    @db.Text
  containmentActions     String    @db.Text
  recommendations        String    @db.Text
  submittedAt            DateTime?
  updatedAt              DateTime  @updatedAt
  createdAt              DateTime  @default(now())

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulation IncidentSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([userId, simulationId])
  @@index([userId])
}

// ── Detection Validation Engine ──────────────────────────────────────────────
// Students write a simple field/operator/value rule set (a constrained,
// Sigma-inspired DSL — not full Sigma syntax) and it's evaluated against a
// fixed, pre-labeled synthetic event log. We compute precision/recall/F1
// server-side rather than trusting anything client-supplied.

model DetectionChallenge {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String     @db.Text
  difficulty  Difficulty
  points      Int        @default(300)
  published   Boolean    @default(true)
  // Array of { id, raw, fields: Record<string,string>, isMalicious: boolean }
  events      Json
  createdAt   DateTime   @default(now())

  submissions DetectionSubmission[]
}

model DetectionSubmission {
  id             String   @id @default(cuid())
  userId         String
  challengeId    String
  // Student's submitted condition set: { logic: "AND"|"OR", conditions: [{field, operator, value}] }
  rule           Json
  truePositives  Int
  falsePositives Int
  falseNegatives Int
  trueNegatives  Int
  precision      Float
  recall         Float
  f1             Float
  score          Int
  passed         Boolean  @default(false)
  submittedAt    DateTime @default(now())
  // Phase 2: Detection Rule Builder enhancements
  ruleType       String   @default("SIGMA") // SIGMA, KQL, SPLUNK, ELASTIC, YARA
  version        Int      @default(1) // Iteration counter
  isPublic       Boolean  @default(false) // Community sharing flag
  updatedAt      DateTime @updatedAt // Last modified

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge DetectionChallenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  versions  DetectionRuleVersion[] // Phase 2: Version history
  shareAcl  DetectionRuleShareAcl?

  @@index([userId])
  @@index([challengeId])
  @@index([isPublic, updatedAt]) // For community feed
  @@index([userId, ruleType]) // User's rules by type
}

// ── Purple Team Replay ───────────────────────────────────────────────────────
// An attack sequence revealed in ordered, cumulative steps. Students hold a
// single detection rule (reusing the same DSL/matcher as the Detection
// Validation Engine — see src/lib/detection-engine.ts) and re-evaluate it
// against the events revealed so far at each step, refining it as the
// attack unfolds rather than grading one static submission all at once.

model PurpleTeamReplay {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String     @db.Text
  difficulty  Difficulty
  points      Int        @default(400)
  published   Boolean    @default(true)
  // Ordered array of { step, narrative, events: DatasetEvent[] } — each
  // step's events are newly revealed at that step (cumulative across the
  // replay, not repeated).
  steps       Json
  createdAt   DateTime   @default(now())

  sessions PurpleTeamReplaySession[]
}

model PurpleTeamReplaySession {
  id          String    @id @default(cuid())
  userId      String
  replayId    String
  currentStep Int       @default(0)
  bestF1      Float     @default(0)
  completedAt DateTime?
  startedAt   DateTime  @default(now())

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  replay PurpleTeamReplay @relation(fields: [replayId], references: [id], onDelete: Cascade)

  @@unique([userId, replayId])
}

// ── SOC Shift Mode ──────────────────────────────────────────────────────────
// A timed triage exercise: a batch of alerts (mostly noise, a few real) drops
// at once, and the student has a time limit to classify each one. Scored on
// speed, triage accuracy, and correct escalation — modeling how a real SOC
// analyst's shift actually works, distinct from single-flag labs.

enum ShiftAlertVerdict {
  TRUE_POSITIVE
  FALSE_POSITIVE
}

enum ShiftAlertAction {
  ESCALATE
  CLOSE
  MONITOR
}

model SocShift {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  briefing     String   @db.Text
  timeLimitSec Int      @default(2700)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())

  alerts                 ShiftAlert[]
  attempts               SocShiftAttempt[]
  tickets                ShiftTicket[]
  ticketQueueLeaderboard TicketQueueLeaderboard[]
}

model ShiftAlert {
  id            String            @id @default(cuid())
  shiftId       String
  order         Int
  source        String
  summary       String            @db.Text
  rawLog        String            @db.Text
  verdict       ShiftAlertVerdict
  correctAction ShiftAlertAction
  explanation   String            @db.Text

  shift   SocShift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  triages ShiftAlertTriage[]

  @@index([shiftId])
}

model SocShiftAttempt {
  id          String    @id @default(cuid())
  userId      String
  shiftId     String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  score       Int?
  accuracyPct Int?

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift         SocShift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  triages       ShiftAlertTriage[]
  ticketTriages ShiftTicketTriage[]

  @@index([userId])
  @@index([shiftId])
}

model ShiftAlertTriage {
  id         String           @id @default(cuid())
  attemptId  String
  alertId    String
  action     ShiftAlertAction
  correct    Boolean
  answeredAt DateTime         @default(now())

  attempt SocShiftAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  alert   ShiftAlert      @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([attemptId, alertId])
  @@index([attemptId])
}

// ── Weekly Threat Bulletin ────────────────────────────────────────────────────

model ThreatBulletin {
  id            String   @id @default(cuid())
  slug          String   @unique
  weekOf        DateTime
  actorOrFamily String
  headline      String
  summary       String   @db.Text
  newCves       String[]
  newIocs       String[]
  ttps          String[]
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([weekOf])
}

// ── PHASE 2 ENGAGEMENT FEATURES ────────────────────────────────────────────
// 17 new models, 2 extensions, no breaking changes

// ── Weekly Incident Cases ─────────────────────────────────────────────────
// Auto-released, difficulty-scaled weekly incident with leaderboard & certs.
// Season/week model prevents year-boundary collisions.

model WeeklyIncidentCase {
  id            String     @id @default(cuid())
  weekStartUTC  DateTime // Monday 00:00 UTC — e.g., 2026-01-05
  weekNumber    Int // 1-52 for current season
  season        Int // e.g., 2026
  incidentSlug  String // Soft reference to IncidentSimulation.slug (not FK)
  difficulty    Difficulty // Progression: EASY (W1-2) -> INSANE (W7-8)
  points        Int        @default(1000)
  releaseTime   DateTime // When case goes live (should match weekStartUTC)
  deadlineTime  DateTime // Sunday 23:59 UTC of that week
  certificateId String?    @unique // Weekly completion cert ID
  published     Boolean    @default(false)
  archivedAt    DateTime? // Soft delete at +8 weeks (null = active)
  createdAt     DateTime   @default(now())

  leaderboard WeeklyIncidentLeaderboard[]
  certificate WeeklyIncidentCertificate?

  @@unique([season, weekNumber])
  @@index([weekStartUTC])
  @@index([published, releaseTime])
  @@index([archivedAt]) // For filtering active cases
}

model WeeklyIncidentLeaderboard {
  id                 String    @id @default(cuid())
  caseId             String
  userId             String
  completedAt        DateTime? // Null if not completed by deadline
  timeTakenMin       Int? // Minutes from release to completion (for tiebreaker)
  score              Int       @default(0) // Derived from evidence board + report
  rank               Int? // Denormalized: 1-N, computed after deadline (null during week)
  rankUpdatedAt      DateTime? // When rank was last computed
  evidenceBoardScore Int? // Pulled from IncidentSimEvidenceBoard.accuracyPct
  reportScore        Int? // From admin review of IncidentSimReport
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  case WeeklyIncidentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([caseId, rank]) // Fast leaderboard: WHERE caseId=X ORDER BY rank LIMIT 100
  @@index([userId, completedAt]) // User progress: did they complete?
  @@index([caseId, completedAt]) // Weekly completion rate analytics
}

model WeeklyIncidentCertificate {
  id          String    @id @default(cuid())
  caseId      String    @unique
  season      Int
  weekNumber  Int
  certCode    String    @unique // e.g., WIC-2026-W01-ABC123DEF
  issuedAt    DateTime  @default(now())
  publishedAt DateTime? // When announced on feed/platform
  createdAt   DateTime  @default(now())

  case WeeklyIncidentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([season, weekNumber])
  @@index([publishedAt]) // For "recent certificates" feed
}

// ── Ticket Queue Simulator ────────────────────────────────────────────────
// SOC shift tickets with SLA enforcement and detailed triage tracking.
// Extends existing SocShift model with per-ticket analysis.

model ShiftTicket {
  id            String    @id @default(cuid())
  shiftId       String
  queuePosition Int // Display order in shift (1-100)
  severity      String // CRITICAL, HIGH, MEDIUM, LOW
  category      String // MALWARE, NETWORK_ANOMALY, COMPLIANCE, FALSE_POSITIVE, etc.
  title         String
  description   String    @db.Text
  rawAlert      Json // Full log event payload
  // SLA enforcement (minutes from creation to resolution)
  slaMinutes    Int // 60 (critical), 240 (high), 480 (medium), 1440 (low)
  createdAt     DateTime  @default(now())
  firstViewedAt DateTime? // When analyst first opened it
  resolvedAt    DateTime? // When marked resolved/escalated/closed
  archivedAt    DateTime? // Soft delete at +8 weeks

  // Triage decision by student
  triage ShiftTicketTriage?

  shift SocShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId, createdAt])
  @@index([shiftId, severity])
  @@index([archivedAt])
}

model ShiftTicketTriage {
  id          String   @id @default(cuid())
  ticketId    String   @unique
  attemptId   String
  userAction  String // CLOSED, ESCALATED, RESOLVED, IGNORED, MONITOR
  confidence  Int // 0-100: student's certainty level
  resolution  String?  @db.Text // Notes/explanation
  isCorrect   Boolean? // Graded after deadline
  pointsAward Int      @default(0)
  triageTime  Int // Seconds from queue open to decision
  createdAt   DateTime @default(now())

  ticket  ShiftTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attempt SocShiftAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([createdAt])
}

model TicketQueueLeaderboard {
  id             String    @id @default(cuid())
  shiftId        String
  userId         String
  scope          String    @default("ALL_TIME") // ALL_TIME, WEEKLY, DAILY
  completedAt    DateTime? // When finished the shift
  accuracy       Float     @default(0.0) // % of correct decisions (0-100)
  speed          Float     @default(0.0) // Average seconds per ticket
  slaViolations  Int       @default(0) // Tickets resolved late
  falsePositives Int       @default(0) // Incorrectly escalated
  missedCritical Int       @default(0) // Missed real incidents
  score          Int       @default(0) // Composite: accuracy + speed - penalties
  rank           Int? // Denormalized: 1-N
  rankUpdatedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  shift SocShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId, scope])
  @@index([shiftId, scope, rank]) // Fast leaderboard
  @@index([userId, scope, completedAt])
  @@index([scope, createdAt]) // For analytics
}

// ── Threat Hunt Sandbox ───────────────────────────────────────────────────
// Investigation sandbox: user hunts through logs to find IoCs and patterns.
// Supports EVTX, Sysmon, Apache, DNS, firewall data at varying scales.

model HuntDataset {
  id                String     @id @default(cuid())
  slug              String     @unique
  name              String
  description       String     @db.Text
  difficulty        Difficulty // EASY (1k), MEDIUM (50k), HARD (500k+)
  category          String // SYSMON, APACHE, NETWORK, DNS, FIREWALL, WINDOWS_EVENTS
  logCount          Int // 1000, 50000, 500000
  formatType        String // EVTX, CSV, JSON, SYSLOG
  // Compressed dataset URL or base64-embedded data
  dataUrl           String?
  dataEmbedded      String?    @db.Text // For small datasets
  // Expected IoCs/patterns: ["IP:192.168.1.100", "PROCESS:cmd.exe", "DOMAIN:evil.com"]
  expectedArtifacts String[]
  published         Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions HuntInvestigationSession[]

  @@index([difficulty])
  @@index([published])
}

model HuntInvestigationSession {
  id             String    @id @default(cuid())
  userId         String
  datasetId      String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  duration       Int? // Total seconds (null if ongoing)
  queriesCount   Int       @default(0)
  artifactsFound Int       @default(0) // Count of HuntArtifact rows
  score          Int       @default(0) // Accuracy * speed / time taken
  status         String    @default("ACTIVE") // ACTIVE, COMPLETED, ABANDONED
  archivedAt     DateTime? // Soft delete at +4 weeks
  createdAt      DateTime  @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset   HuntDataset    @relation(fields: [datasetId], references: [id])
  queries   HuntQuery[]
  artifacts HuntArtifact[]

  @@index([userId, startedAt])
  @@index([userId, status]) // "My active hunts"
  @@index([datasetId])
  @@index([status, createdAt])
  @@index([archivedAt])
}

model HuntQuery {
  id          String   @id @default(cuid())
  sessionId   String
  query       String   @db.Text // User's search/filter expression
  language    String // GREP, REGEX, KQL, SQL_LITE, NATURAL_LANGUAGE
  resultCount Int // How many log lines matched
  matchedIocs String[] // Which expected artifacts this query caught
  isEffective Boolean? // True if found something new (not seen in prior queries)
  executedAt  DateTime @default(now())

  session HuntInvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, executedAt])
  @@index([executedAt])
}

model HuntArtifact {
  id         String   @id @default(cuid())
  sessionId  String
  artifactId String // Must match one in HuntDataset.expectedArtifacts
  type       String // IP, DOMAIN, PROCESS, FILE, REGISTRY, HASH, etc.
  value      String // e.g., "192.168.1.100", "cmd.exe"
  confidence Int // 0-100: user's certainty
  foundAt    DateTime @default(now())

  session HuntInvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, artifactId])
  @@index([sessionId])
}

// ── Detection Rule Builder ───────────────────────────────────────────────

model DetectionRuleVersion {
  id           String   @id @default(cuid())
  submissionId String
  version      Int // 1, 2, 3, ...
  rule         Json // Full rule snapshot at this version
  ruleType     String // Inherited from parent
  f1           Float // Validation score at this version
  notes        String? // Change summary: "Added process.name filter"
  createdAt    DateTime @default(now())

  submission DetectionSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, version])
  @@index([submissionId, createdAt])
}

model DetectionRuleShareAcl {
  id           String   @id @default(cuid())
  submissionId String   @unique
  accessType   String   @default("PRIVATE") // PRIVATE, COMMUNITY, RECRUITER_ONLY
  sharedBy     String // User ID who shared it
  sharedAt     DateTime @default(now())

  submission DetectionSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  owner      User                @relation(fields: [sharedBy], references: [id], onDelete: Cascade)

  @@index([accessType])
  @@index([sharedBy, sharedAt])
}

// ── Career Portfolio ──────────────────────────────────────────────────────
// Read-only materialized view of user's achievements: labs, incidents, certs, etc.
// Portfolio aggregation runs on 5-min schedule; visibility controlled by user.

model CareerPortfolio {
  id             String    @id @default(cuid())
  userId         String    @unique
  slug           String    @unique // URL-safe: "alice-smith" or "alice-smith-2"
  visibility     String    @default("PRIVATE") // PRIVATE, PUBLIC, RECRUITER_ONLY
  bio            String?   @db.Text
  profileHtml    String?   @db.Text // Pre-rendered portfolio HTML (optional)
  lastUpdatedAt  DateTime  @default(now())
  lastComputedAt DateTime? // When aggregation job ran

  // Denormalized aggregates (updated by background job)
  totalLabsSolved      Int      @default(0)
  totalIncidentsSolved Int      @default(0)
  totalWeeklyCerts     Int      @default(0)
  totalCompetitionsWon Int      @default(0)
  totalRulesShared     Int      @default(0)
  huntsCompleted       Int      @default(0)
  mitreTopTactics      String[] // Top 5: ["PERSISTENCE", "PRIVILEGE_ESCALATION", ...]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user          User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievements  CareerPortfolioAchievement[]
  mitreCoverage CareerPortfolioMitreCoverage?
  visitorLog    PortfolioVisitorLog[]

  @@index([visibility, lastUpdatedAt]) // For recruiter/public discovery
  @@index([userId])
}

model CareerPortfolioAchievement {
  id           String   @id @default(cuid())
  portfolioId  String
  type         String // LAB_SOLVED, INCIDENT_COMPLETED, WEEKLY_CERT, LEADERBOARD_TOP10, HUNT_STREAK, RULE_SHARED
  title        String // "Solved: Advanced XSS" or "Weekly Champion: Week 5"
  description  String   @db.Text
  icon         String? // Glyph/emoji: "⚡", "🏆", etc.
  relatedId    String? // Lab slug, Incident slug, Cert ID, Hunt ID
  earnedAt     DateTime // When achievement was unlocked
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  portfolio CareerPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, displayOrder])
  @@index([portfolioId, earnedAt])
  @@index([earnedAt]) // For timeline queries
}

model CareerPortfolioMitreCoverage {
  id          String   @id @default(cuid())
  portfolioId String   @unique
  // HeatMap JSON: { INITIAL_ACCESS: 5, PERSISTENCE: 8, ... }
  // Value = count of incidents/labs addressing that tactic
  heatmap     Json     @default("{}")
  lastUpdated DateTime @updatedAt

  portfolio CareerPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([lastUpdated])
}

model PortfolioVisitorLog {
  id          String   @id @default(cuid())
  portfolioId String
  visitorId   String? // Null for anonymous viewers
  viewedAt    DateTime @default(now())

  portfolio CareerPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  visitor   User?           @relation("PortfolioVisitors", fields: [visitorId], references: [id], onDelete: SetNull)

  @@index([portfolioId, viewedAt])
  @@index([visitorId, viewedAt])
}

// ── AI Mentor (Hint Enhancement) ──────────────────────────────────────────

model MentorHintQuality {
  id                 String   @id @default(cuid())
  hintId             String   @unique
  avgScore           Float    @default(5.0) // 0-10 weighted moving average
  totalRatings       Int      @default(0) // Denominator for avgScore
  helpfulCount       Int      @default(0)
  notHelpfulCount    Int      @default(0)
  submissionRate     Float    @default(0.0) // % of viewers who solved after
  inferredDifficulty String   @default("MEDIUM") // Computed from contextDifficulty
  lastUpdatedAt      DateTime @updatedAt

  @@index([avgScore]) // Rank hints by effectiveness
  @@index([hintId])
}

model MentorHintSequence {
  id          String   @id @default(cuid())
  userId      String
  labId       String
  stage       String // e.g., "reconnaissance", "exploitation"
  // Array of hint IDs already shown: ["hint-001", "hint-003"]
  shownHints  String[]
  // Timestamp when last hint was shown (prevents rapid re-use within 5 min)
  lastShownAt DateTime @default(now())
  // After 90 days, hints can be re-shown (learning opportunity revisit)
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([userId, labId, stage])
  @@index([userId, expiresAt]) // For cleanup jobs
}

// â”€â”€ PHASE 3: COMPETITION & COMMUNITY â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Naming note: Team* is already taken by per-simulation session teams, so
// persistent player groups are Squad*.

enum Tier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  MASTER
}

enum SquadRole {
  OWNER
  OFFICER
  MEMBER
}

enum SquadJoinPolicy {
  OPEN
  INVITE_ONLY
  CLOSED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
}

enum TournamentEntrantType {
  SOLO
  SQUAD
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  PENDING
  READY
  IN_PROGRESS
  COMPLETED
  WALKOVER
}

enum MentorshipStatus {
  REQUESTED
  ACTIVE
  COMPLETED
  DECLINED
  ENDED
}

// â”€â”€ Ranked seasons & tier ladder â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Season {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean   @default(false)
  // Set once the season closes and final placements are frozen.
  concludedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ratings     SeasonRating[]
  squadStats  SquadSeasonStat[]
  tournaments Tournament[]

  @@index([active, startsAt])
  @@index([endsAt])
}

model SeasonRating {
  id            String    @id @default(cuid())
  seasonId      String
  userId        String
  // Elo-style rating; tier is derived from it but stored for cheap filtering.
  rating        Int       @default(1000)
  tier          Tier      @default(BRONZE)
  peakRating    Int       @default(1000)
  wins          Int       @default(0)
  losses        Int       @default(0)
  eventsPlayed  Int       @default(0)
  // Denormalised placement, recomputed by the season ranking job.
  rank          Int?
  rankUpdatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@index([seasonId, rank])
  @@index([seasonId, rating])
  @@index([seasonId, tier])
  @@index([userId])
}

// â”€â”€ Persistent squads â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Squad {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  // Short display tag, e.g. SOC
  tag         String
  description String?         @db.Text
  ownerId     String
  joinPolicy  SquadJoinPolicy @default(INVITE_ONLY)
  maxMembers  Int             @default(20)
  disbandedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner             User                @relation("SquadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members           SquadMember[]
  invites           SquadInvite[]
  seasonStats       SquadSeasonStat[]
  tournamentEntries TournamentEntrant[]

  @@index([joinPolicy, disbandedAt])
  @@index([ownerId])
}

model SquadMember {
  id       String    @id @default(cuid())
  squadId  String
  userId   String
  role     SquadRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One squad per user keeps rosters and team scoring unambiguous.
  @@unique([userId])
  @@unique([squadId, userId])
  @@index([squadId, role])
}

model SquadInvite {
  id          String       @id @default(cuid())
  squadId     String
  inviteeId   String
  invitedById String
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime     @default(now())

  squad     Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  invitee   User  @relation("SquadInviteRecipient", fields: [inviteeId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("SquadInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([squadId, inviteeId, status])
  @@index([inviteeId, status])
  @@index([expiresAt])
}

model SquadSeasonStat {
  id            String    @id @default(cuid())
  squadId       String
  seasonId      String
  points        Int       @default(0)
  wins          Int       @default(0)
  losses        Int       @default(0)
  rank          Int?
  rankUpdatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  squad  Squad  @relation(fields: [squadId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([squadId, seasonId])
  @@index([seasonId, rank])
  @@index([seasonId, points])
}

// â”€â”€ Tournaments & brackets â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Tournament {
  id          String                @id @default(cuid())
  slug        String                @unique
  name        String
  description String?               @db.Text
  seasonId    String?
  format      TournamentFormat      @default(SINGLE_ELIMINATION)
  entrantType TournamentEntrantType @default(SOLO)
  status      TournamentStatus      @default(DRAFT)
  // Bracket size must be a power of two for single elimination; entrants
  // beyond this are rejected at registration.
  maxEntrants Int                   @default(16)

  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  startsAt             DateTime
  completedAt          DateTime?

  labSlugs  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season   Season?             @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  entrants TournamentEntrant[]
  matches  TournamentMatch[]

  @@index([status, startsAt])
  @@index([seasonId])
}

model TournamentEntrant {
  id           String    @id @default(cuid())
  tournamentId String
  // Exactly one of userId / squadId is set, matching Tournament.entrantType.
  userId       String?
  squadId      String?
  seed         Int?
  eliminatedAt DateTime?
  finalRank    Int?
  createdAt    DateTime  @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  squad      Squad?     @relation(fields: [squadId], references: [id], onDelete: Cascade)

  matchesAsA TournamentMatch[] @relation("MatchEntrantA")
  matchesAsB TournamentMatch[] @relation("MatchEntrantB")
  matchesWon TournamentMatch[] @relation("MatchWinner")

  @@unique([tournamentId, userId])
  @@unique([tournamentId, squadId])
  @@index([tournamentId, seed])
}

model TournamentMatch {
  id           String      @id @default(cuid())
  tournamentId String
  // Round 1 is the first played round; position orders pairings within it.
  round        Int
  position     Int
  entrantAId   String?
  entrantBId   String?
  winnerId     String?
  scoreA       Int         @default(0)
  scoreB       Int         @default(0)
  status       MatchStatus @default(PENDING)
  scheduledAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tournament Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  entrantA   TournamentEntrant? @relation("MatchEntrantA", fields: [entrantAId], references: [id], onDelete: SetNull)
  entrantB   TournamentEntrant? @relation("MatchEntrantB", fields: [entrantBId], references: [id], onDelete: SetNull)
  winner     TournamentEntrant? @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, round, position])
  @@index([tournamentId, status])
}

// â”€â”€ Social graph & peer review â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowTarget", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model WriteupVote {
  id        String   @id @default(cuid())
  writeupId String
  userId    String
  // +1 or -1; enforced in application code.
  value     Int
  createdAt DateTime @default(now())

  writeup Writeup @relation(fields: [writeupId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([writeupId, userId])
  @@index([writeupId])
}

model PeerReview {
  id         String       @id @default(cuid())
  writeupId  String
  reviewerId String
  // 1-5 overall quality score.
  rating     Int
  comment    String       @db.Text
  status     ReviewStatus @default(PENDING)
  helpful    Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  writeup  Writeup @relation(fields: [writeupId], references: [id], onDelete: Cascade)
  reviewer User    @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  // A reviewer gives one review per writeup.
  @@unique([writeupId, reviewerId])
  @@index([writeupId, status])
  @@index([reviewerId])
}

model MentorshipPair {
  id        String           @id @default(cuid())
  mentorId  String
  menteeId  String
  status    MentorshipStatus @default(REQUESTED)
  focus     String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  mentor User @relation("MentorshipMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee User @relation("MentorshipMentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@unique([mentorId, menteeId])
  @@index([menteeId, status])
  @@index([mentorId, status])
}

// â”€â”€ PHASE 4: PROFESSIONAL DEVELOPMENT â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Extends the existing JobPosting and academy Assessment models rather than
// replacing them: JobPosting gains applications, and skill assessments are a
// separate standalone credential track from module-bound academy work.

enum ApplicationStatus {
  SUBMITTED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum SeniorityLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum InterviewStatus {
  IN_PROGRESS
  SUBMITTED
  SCORED
  ABANDONED
}

enum CredentialStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

// â”€â”€ Job applications â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model JobApplication {
  id            String            @id @default(cuid())
  jobId         String
  applicantId   String
  status        ApplicationStatus @default(SUBMITTED)
  coverNote     String?           @db.Text
  // Snapshot of the portfolio slug at apply time, so a later rename does not
  // break the recruiter's link back to what they actually reviewed.
  portfolioSlug String?
  appliedAt     DateTime          @default(now())
  decidedAt     DateTime?
  updatedAt     DateTime          @updatedAt

  job       JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant User       @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  events JobApplicationEvent[]

  // One live application per candidate per role.
  @@unique([jobId, applicantId])
  @@index([jobId, status])
  @@index([applicantId, appliedAt])
}

model JobApplicationEvent {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?            @db.Text
  actorId       String?
  createdAt     DateTime           @default(now())

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

// â”€â”€ Skill gap analysis â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model RoleProfile {
  id                   String         @id @default(cuid())
  slug                 String         @unique
  title                String
  description          String         @db.Text
  seniority            SeniorityLevel @default(JUNIOR)
  // MITRE tactics this role is expected to cover, and the minimum number of
  // solved items per tactic to count as covered.
  requiredTactics      Json           @default("{}")
  // Learning paths recommended to close a gap, referenced by slug so path
  // content can be reorganised without breaking role definitions.
  recommendedPathSlugs String[]
  published            Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  snapshots SkillGapSnapshot[]

  @@index([published, seniority])
}

model SkillGapSnapshot {
  id            String   @id @default(cuid())
  userId        String
  roleProfileId String
  // 0-100 overall readiness for the role.
  readiness     Int      @default(0)
  // { TACTIC: { have: n, need: n } } for every required tactic.
  coverage      Json     @default("{}")
  // Ordered tactic names the user is short on, worst first.
  gaps          String[]
  generatedAt   DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleProfile RoleProfile @relation(fields: [roleProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, roleProfileId])
  @@index([userId, generatedAt])
}

// â”€â”€ Interview preparation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model InterviewKit {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  description  String         @db.Text
  seniority    SeniorityLevel @default(JUNIOR)
  difficulty   Difficulty     @default(MEDIUM)
  timeLimitSec Int            @default(2700)
  // [{ id, prompt, idealPoints: string[], weight }]
  questions    Json
  published    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  sessions InterviewSession[]

  @@index([published, seniority])
}

model InterviewSession {
  id          String          @id @default(cuid())
  userId      String
  kitId       String
  status      InterviewStatus @default(IN_PROGRESS)
  startedAt   DateTime        @default(now())
  submittedAt DateTime?
  // 0-100, set once every answer has been scored.
  score       Int?
  // Free-text summary produced at scoring time.
  feedback    String?         @db.Text

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kit     InterviewKit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
  answers InterviewAnswer[]

  @@index([userId, startedAt])
  @@index([kitId, status])
}

model InterviewAnswer {
  id         String   @id @default(cuid())
  sessionId  String
  // Matches an id inside InterviewKit.questions.
  questionId String
  answer     String   @db.Text
  // 0-100 for this answer; null until scored.
  score      Int?
  feedback   String?  @db.Text
  answeredAt DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId])
}

// â”€â”€ Verified skill assessments â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model SkillAssessment {
  id           String     @id @default(cuid())
  slug         String     @unique
  title        String
  description  String     @db.Text
  domain       String // e.g. DETECTION, FORENSICS, CLOUD
  difficulty   Difficulty @default(MEDIUM)
  timeLimitSec Int        @default(3600)
  // Percentage required to earn the credential.
  passingScore Int        @default(70)
  // How long an earned credential stays valid, in days. Null never expires.
  validityDays Int?
  // [{ id, prompt, type, options, answer, points }]
  questions    Json
  published    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  attempts    SkillAssessmentAttempt[]
  credentials VerifiedCredential[]

  @@index([published, domain])
}

model SkillAssessmentAttempt {
  id           String    @id @default(cuid())
  userId       String
  assessmentId String
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  // Null until submitted or auto-expired.
  score        Int?
  passed       Boolean   @default(false)
  // Integrity signals gathered during the attempt, e.g. tab-blur counts.
  proctorFlags Json      @default("{}")
  // Answers keyed by question id.
  responses    Json      @default("{}")

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment SkillAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId, assessmentId])
  @@index([assessmentId, passed])
}

model VerifiedCredential {
  id            String           @id @default(cuid())
  userId        String
  assessmentId  String
  // Public, shareable verification code.
  code          String           @unique
  score         Int
  status        CredentialStatus @default(ACTIVE)
  issuedAt      DateTime         @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment SkillAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Re-passing refreshes the existing credential rather than issuing a second.
  @@unique([userId, assessmentId])
  @@index([status, expiresAt])
}

// ── Monthly Championship ────────────────────────────────────────────────────
// A recurring monthly event over a fixed set of challenges. One championship
// exists per calendar month; the rollover cron opens the next and concludes
// the previous, awarding certificates to the podium and finalists.

model Championship {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  description String             @db.Text
  year        Int
  month       Int // 1-12
  // UTC window. endsAt is the last instant of the month, so a comparison
  // against it cannot admit a solve belonging to the next championship.
  startsAt    DateTime
  endsAt      DateTime
  // Lab slugs making up the challenge set, soft-referenced like Competition.
  labSlugs    Json
  status      ChampionshipStatus @default(SCHEDULED)
  published   Boolean            @default(false)
  concludedAt DateTime?
  createdAt   DateTime           @default(now())

  entries ChampionshipEntry[]
  awards  ChampionshipAward[]

  // One championship per month, which is what makes the rollover idempotent.
  @@unique([year, month])
  @@index([status, startsAt])
  @@index([published, startsAt])
}

model ChampionshipEntry {
  id             String    @id @default(cuid())
  championshipId String
  userId         String
  score          Int       @default(0)
  solved         Int       @default(0)
  // Drives the tie-break: equal scores are ordered by who got there first.
  lastSolvedAt   DateTime?
  // Written once at conclusion; null while the championship is running.
  rank           Int?
  joinedAt       DateTime  @default(now())

  championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([championshipId, userId])
  @@index([championshipId, score])
  @@index([userId])
}

model ChampionshipAward {
  id             String           @id @default(cuid())
  championshipId String
  userId         String
  rank           Int
  tier           ChampionshipTier
  // Public verification code, e.g. MCH-2026-08-1-K7QR4M.
  certCode       String           @unique
  issuedAt       DateTime         @default(now())

  championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Re-running the conclusion must not issue a second award.
  @@unique([championshipId, userId])
  @@index([userId, issuedAt])
}

enum ChampionshipStatus {
  SCHEDULED
  ACTIVE
  CONCLUDED
}

enum ChampionshipTier {
  CHAMPION
  MEDALLIST
  FINALIST
  COMPETITOR
}

// ── Cyber Crisis Command Center ─────────────────────────────────────────────
// Scenario content is authored in src/content/crisis-scenarios.ts rather than
// stored, so scenarioSlug is a soft reference. Only the player's run is
// persisted, which keeps a scenario editable without migrating live runs.

model CrisisRun {
  id           String @id @default(cuid())
  userId       String
  scenarioSlug String

  status CrisisRunStatus @default(IN_PROGRESS)

  // Simulation clock, in sim-minutes since the incident opened.
  minute        Int @default(0)
  containment   Int @default(0)
  reputation    Int @default(0)
  morale        Int @default(0)
  // Accumulated loss in whole currency units; monotonic.
  financialLoss Int @default(0)

  // Written at completion.
  score Int?
  band  String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisions CrisisDecision[]

  @@index([userId, startedAt])
  @@index([scenarioSlug, status])
  @@index([scenarioSlug, score])
}

model CrisisDecision {
  id        String   @id @default(cuid())
  runId     String
  injectId  String
  optionId  String
  // Sim-minute at which the decision was taken.
  atMinute  Int
  createdAt DateTime @default(now())

  run CrisisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  // One answer per inject per run — replaying an inject must not double-score.
  @@unique([runId, injectId])
  @@index([runId])
}

enum CrisisRunStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model ScenarioReport {
  id         String               @id @default(cuid())
  scenarioId String
  reporterId String
  reason     ScenarioReportReason
  detail     String?              @db.Text
  status     ReportStatus         @default(OPEN)

  reviewedById String?
  reviewedAt   DateTime?
  resolution   String?   @db.Text

  createdAt DateTime @default(now())

  scenario   CustomScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  reporter   User           @relation("ScenarioReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User?          @relation("ScenarioReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  // One report per person per scenario; re-reporting updates rather than
  // inflating the queue.
  @@unique([scenarioId, reporterId])
  @@index([status, createdAt])
  @@index([scenarioId])
}

enum ScenarioReportReason {
  INAPPROPRIATE
  PLAGIARISM
  MISLEADING
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  UPHELD
  DISMISSED
}
